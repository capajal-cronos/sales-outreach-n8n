# Keep the build context small and prevent secrets / local state from
# ending up in the image.

node_modules
dist
data
.env
.env.local
.env.*.local
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# Dev-only / docs / tooling not needed in the image.
*.md
!db/init.sql
.vscode
.idea
.claude
deploy
n8n
n8n-workflows

# Editor / OS junk.
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cloudflared
*.pem
cert.pem
config.yml

# Logs.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
