# ─────────────────────────────────────────────────────────────
# n8n
# ─────────────────────────────────────────────────────────────
# Base URL of your n8n instance's webhook path. All 9 workflow
# endpoints (organizations, find-people, send-leads-mails,
# email-approval, ...) are derived from this single value.
# No trailing slash.
VITE_N8N_BASE_URL=https://your-n8n.app.n8n.cloud/webhook

# ─────────────────────────────────────────────────────────────
# Pipedrive
# ─────────────────────────────────────────────────────────────
# Server-only key. The Express API proxies every Pipedrive call
# from the browser through /api/pipedrive/* so this never ends
# up in the public JS bundle.
PIPEDRIVE_API_KEY=your_pipedrive_api_key_here

# Pipedrive custom-field keys — run `npm run setup:pipedrive` to
# generate and auto-fill these. Field-key identifiers (not secrets),
# safe to expose to the browser.
VITE_PIPEDRIVE_PERSON_LINKEDIN_KEY=
VITE_PIPEDRIVE_PERSON_HEADLINE_KEY=
VITE_PIPEDRIVE_ORG_APOLLO_ID_KEY=
VITE_PIPEDRIVE_ORG_COMPANY_DESCRIPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Storage backend. "json" (default) writes to data/*.json and only
# works on a single machine. "postgres" uses DATABASE_URL — required
# for Cloud Run or any multi-instance hosting.
DB_DRIVER=json

# Postgres connection string. Only read when DB_DRIVER=postgres.
# Local dev (with `docker compose up -d postgres`):
#   postgres://leadflow:leadflow_dev_password@127.0.0.1:5432/leadflow
# Cloud SQL via the Cloud SQL Auth Proxy unix socket:
#   postgres://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3001

# Set to "production" in deployed environments. When production,
# Express serves the built frontend from dist/ on the same origin
# and CORS rejects unrecognized cross-origin requests.
NODE_ENV=development

# Comma-separated list of origins allowed to make cross-origin
# requests to the API. Defaults to http://localhost:3000 in dev
# (Vite dev server) and same-origin only in production.
# FRONTEND_ORIGIN=https://app.yourdomain.com

# ─────────────────────────────────────────────────────────────
# Cloudflare Tunnel — only needed for local development when n8n
# runs in the cloud and needs to reach your localhost API.
# Not used in production deployments.
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_NAME=sales-outreach-n8n
CLOUDFLARE_TUNNEL_URL=https://api.yourdomain.com
